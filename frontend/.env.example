# URL base de la API real (NestJS), con el prefijo completo incluido.
# La API corre por defecto en el puerto 3000; este frontend corre en el
# 3001 (`npm run dev` ya usa `next dev -p 3001`) para no chocar con ella.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Cuando conectes Supabase Storage para imágenes de producto / DNI / selfies:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Client ID (público, sandbox) de tu app de developer.paypal.com — el MISMO
# par Client ID/Secret configurado en API_REST/.env (PAYPAL_CLIENT_ID). Solo
# renderiza los botones; la orden real se crea/captura en el backend.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=tu_client_id_sandbox

# Client ID de tipo "Web application" de Google Cloud Console — el MISMO
# valor que GOOGLE_CLIENT_ID en API_REST/.env (el backend lo usa como
# `audience` al verificar el idToken). No es secreto, va en el bundle del
# navegador. Sin esta variable, el botón "Continuar con Google" simplemente
# no se muestra (ver GoogleSignInButton.tsx).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
