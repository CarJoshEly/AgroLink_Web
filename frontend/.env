# URL base de la API real (NestJS), con el prefijo completo incluido.
# La API corre por defecto en el puerto 3000; este frontend corre en el
# 3001 (`npm run dev` ya usa `next dev -p 3001`) para no chocar con ella.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# PayPal Integration (Sandbox Client ID)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=test

